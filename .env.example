# URL pública do site (metadados, sitemap, OG)
SITE_URL=http://localhost:3000

# Painel /admin — gerados automaticamente pelo ./lukwolfly.sh na 1ª execução
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=gere-um-segredo-com-32-caracteres-ou-mais

# Notificação de pedidos no Telegram (opcional)
# 1) crie um bot no @BotFather e cole o token
# 2) mande uma mensagem pro bot e pegue o chat id em https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Túnel nomeado da Cloudflare (./lukwolfly.sh up --named)
CLOUDFLARE_TUNNEL_TOKEN=
